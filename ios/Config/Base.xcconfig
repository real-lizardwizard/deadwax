// deadwax for iPhone - the build settings, as text, so they are edited and reviewed like code.
// The .pbxproj holds almost nothing; everything a build needs is here (and in Info.plist).
// See notes/ios.md.

// The app's identity. NEVER change the bundle id once the app is on the phone: a new one is a new,
// empty app (downloads and all gone), and spends one of a free account's App IDs.
PRODUCT_NAME = Deadwax
PRODUCT_BUNDLE_IDENTIFIER = net.lizardlounge.deadwax

// The app's own version, apart from the server's (src/__init__.py): 0.1 was Phase 0, 0.2 Phase 1's shell, 0.3 Phase 2's downloads, 0.4 lyrics, 0.5 the EQ, 0.6 the turntable, 0.7 the speed fader, 0.8 play history, 0.9 your library downloaded, 0.10 the Library (playlists, the switch, artists, songs), 0.11 Search (MusicBrainz beside your library, what's saved, More), then Requests and Get, 0.12 getting albums done (Join, Add to my library, Pick the best source for me, You's Getting albums), 0.13 is managing (You > Manage: the editors, Needs a look, Library care, People, Server settings and the event log, opened in the web app in Safari).
MARKETING_VERSION = 0.13
CURRENT_PROJECT_VERSION = 13

// A device build only: James's Mac has no Simulator runtime, and none is needed.
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// Info.plist is a plain file (Config/Info.plist), not generated. No asset catalog and no storyboard
// anywhere: actool and ibtool need a Simulator runtime (the plan's risk R2). The icon is loose PNGs.
INFOPLIST_FILE = Config/Info.plist
GENERATE_INFOPLIST_FILE = NO
ASSETCATALOG_COMPILER_APPICON_NAME =
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME =
ENABLE_PREVIEWS = NO

// The Mac app (notes/ios.md "The Mac app, slice 1"): the same target built for the Mac through Mac Catalyst
// (-destination 'generic/platform=macOS,variant=Mac Catalyst'; ios/scripts/install-mac.sh). Beside the two below,
// which only let the Mac be a destination and keep its id, every Mac setting is [sdk=macosx*], so the iPhone build's
// are as they were; check_project.py holds each. No MACOSX_DEPLOYMENT_TARGET:
// it follows the iPhone's 17.0 to macOS 14. No profile: the sandbox and the outgoing network are build settings, which
// need none (and the sign-in is kept in a file on the Mac, not the Keychain - SessionStore).
// After every setting it qualifies: a KEY = later in the file (or in Debug/Release.xcconfig) hides KEY[sdk=...] -
// the Mac build read Info.plist while this block stood above INFOPLIST_FILE.
SUPPORTS_MACCATALYST = YES
// already the default; said, so the Mac's bundle id can't drift from the phone's to a "maccatalyst." one
DERIVE_MACCATALYST_PRODUCT_BUNDLE_IDENTIFIER = NO
// the Mac idiom: Mac sizes and controls (James, 17 Nov)
TARGETED_DEVICE_FAMILY[sdk=macosx*] = 6
// Info.plist less LSSupportsOpeningDocumentsInPlace (macOS refuses NO), plus the Mac's own keys
INFOPLIST_FILE[sdk=macosx*] = Config/Info-Mac.plist
// the App Sandbox: every path the app uses is its container's, as on the phone; and its requests may go out
ENABLE_APP_SANDBOX[sdk=macosx*] = YES
ENABLE_OUTGOING_NETWORK_CONNECTIONS[sdk=macosx*] = YES

// Swift 5 language mode, as the package's audio target: nothing of the app compiles on Linux, so a
// strict-concurrency error would only show on the Mac.
SWIFT_VERSION = 5.0
SWIFT_EMIT_LOC_STRINGS = NO
STRING_CATALOG_GENERATE_SYMBOLS = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
CLANG_ENABLE_MODULES = YES
ALWAYS_SEARCH_USER_PATHS = NO

// Signing: automatic, with James's free Personal Team. DEVELOPMENT_TEAM comes from Local.xcconfig,
// which is his alone (gitignored; copy Local.xcconfig.example). CI builds with signing off.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
#include? "Local.xcconfig"
